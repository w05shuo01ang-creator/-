<view class="page">
  <view class="account-head">
    <view>
      <text class="head-title">我的表情</text>
      <text class="head-sub">已加载 {{items.length}} / {{totalItems}} 张 · 按状态和标签管理</text>
    </view>
  </view>

  <view class="head-actions {{batchUploadEnabled ? '' : 'two-actions'}}">
    <button class="ai-button" bindtap="openAiCreate" disabled="{{batchUploading}}">AI制作</button>
    <button class="batch-button" wx:if="{{batchUploadEnabled}}" bindtap="startBatchUpload" disabled="{{batchUploading}}">批量导入</button>
    <button class="upload-button" bindtap="showUpload" disabled="{{batchUploading}}">＋ 上传</button>
  </view>

  <view class="tabs">
    <view class="tab {{currentTab === 'private' ? 'active' : ''}}" data-tab="private" bindtap="changeTab"><text>私密</text><text class="tab-count">{{tabCounts.private}}</text></view>
    <view class="tab {{currentTab === 'review' ? 'active' : ''}}" data-tab="review" bindtap="changeTab"><text>审核</text><text class="tab-count">{{tabCounts.review}}</text></view>
    <view class="tab {{currentTab === 'public' ? 'active' : ''}}" data-tab="public" bindtap="changeTab"><text>已公开</text><text class="tab-count">{{tabCounts.public}}</text></view>
  </view>

  <view class="batch-progress" wx:if="{{batchUploading}}">
    <text>{{batchProgress}}</text>
    <text class="batch-stop" bindtap="stopBatchUpload">停止</text>
  </view>

  <view class="library-tools">
    <view class="mine-search">
      <text class="search-symbol">⌕</text>
      <input class="mine-search-input" value="{{searchQuery}}" placeholder="搜索描述或标签" bindinput="onSearchInput" />
      <text class="search-clear" wx:if="{{searchQuery}}" bindtap="clearSearch">×</text>
    </view>
    <scroll-view class="tag-filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="tag-filter-row">
        <view class="filter-tag {{activeTag === item.key ? 'active' : ''}}" wx:for="{{tagFilters}}" wx:key="key" data-key="{{item.key}}" bindtap="selectFilterTag">
          <text>{{item.label}}</text><text class="filter-count">{{item.count}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="mine-list" wx:if="{{filtered.length}}">
    <view class="mine-item" wx:for="{{filtered}}" wx:key="_id">
      <image class="thumb" src="{{item.displayUrl}}" mode="aspectFill" bindtap="preview" data-url="{{item.displayUrl}}" />
      <view class="item-main" bindtap="openDetail" data-id="{{item._id}}">
        <text class="item-prompt">{{item.prompt || '未命名表情'}}</text>
        <text class="item-tags">{{item.tagsText || '无标签'}}</text>
        <view class="item-meta">
          <text class="item-status status-{{item.reviewStatus}}">{{item.reviewStatusText}}</text>
          <text class="item-date">{{item.createdAtText}}</text>
        </view>
      </view>
      <view class="actions">
        <text class="action" catchtap="save" data-item="{{item}}">保存</text>
        <text class="action primary" wx:if="{{item.reviewStatus === 'private' || item.reviewStatus === 'manual_review' || item.reviewStatus === 'rejected'}}" catchtap="publish" data-id="{{item._id}}">{{item.reviewStatus === 'manual_review' ? '重试审核' : '公开'}}</text>
        <text class="action danger" catchtap="remove" data-id="{{item._id}}">删除</text>
      </view>
    </view>
  </view>

  <button class="load-more" wx:if="{{hasMore}}" bindtap="loadMore" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多表情</button>

  <view class="empty" wx:if="{{!loading && !filtered.length}}">
    <text class="empty-title">{{searchQuery || activeTag ? '没有匹配的表情' : '这里还没有表情'}}</text>
    <text>{{searchQuery || activeTag ? '换一个关键词或标签试试' : currentTab === 'private' ? '上传后会默认保存在私密区' : currentTab === 'review' ? '待审核和被拒绝的内容会显示在这里' : '审核通过的内容会显示在这里'}}</text>
  </view>
  <view class="loading" wx:if="{{loading}}">正在整理...</view>

  <view class="mask" wx:if="{{showUpload}}" bindtap="hideUpload">
    <view class="sheet" catchtap="stopBubble">
      <view class="sheet-head">
        <text class="sheet-title">添加一张表情</text>
        <text class="sheet-close" bindtap="hideUpload">×</text>
      </view>

      <view class="picker" bindtap="chooseImage">
        <image class="picker-image" wx:if="{{filePath}}" src="{{filePath}}" mode="aspectFit" />
        <view class="picker-empty" wx:else>
          <text class="picker-plus">＋</text>
          <text>从相册或相机选择</text>
          <text class="picker-hint">JPG / PNG，最大 5 MB</text>
        </view>
      </view>

      <text class="field-label">描述</text>
      <input class="field" value="{{prompt}}" maxlength="60" placeholder="例如：下班后开心冲出办公室" bindinput="onPrompt" />

      <view class="field-head">
        <text class="field-label">标签</text>
        <text class="field-hint">最多 5 个，每个 10 字</text>
      </view>
      <view class="tag-entry">
        <input class="field tag-field" value="{{tagInput}}" maxlength="10" placeholder="输入标签" bindinput="onTagInput" bindconfirm="addTag" />
        <text class="tag-add" bindtap="addTag">添加</text>
      </view>
      <view class="tag-list">
        <view class="tag" wx:for="{{tags}}" wx:key="*this">#{{item}} <text class="tag-remove" data-index="{{index}}" bindtap="removeTag">×</text></view>
      </view>

      <button class="primary-button submit" loading="{{uploading}}" disabled="{{uploading || !filePath}}" bindtap="upload">保存到私密区</button>
    </view>
  </view>
</view>
