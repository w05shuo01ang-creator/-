.account-head {
  padding: 38rpx 30rpx 22rpx;
  background: #f8faf9;
}

.head-title {
  display: block;
}

.head-title {
  font-size: 42rpx;
  font-weight: 750;
}

.head-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding: 0 30rpx 28rpx;
  border-bottom: 1rpx solid #e6e9ee;
  background: #f8faf9;
}

.upload-button,
.ai-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 70rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 7rpx;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1;
  box-sizing: border-box;
}

.upload-button {
  background: #165dff;
  color: #ffffff;
}

.ai-button {
  border: 1rpx solid #18202a;
  background: #18202a;
  color: #ffffff;
}

.batch-rail {
  position: fixed;
  z-index: 12;
  top: 54%;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 118rpx;
  border: 1rpx solid #b9c8be;
  border-right: 0;
  border-radius: 8rpx 0 0 8rpx;
  background: #ffffff;
  color: #28664d;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.45;
  box-shadow: 0 6rpx 18rpx rgba(24, 32, 42, 0.1);
}

.tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  padding: 0 30rpx;
  border-bottom: 1rpx solid #e6e9ee;
  background: #ffffff;
}

.tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  padding: 23rpx 0;
  color: #77808c;
}

.tab.active {
  color: #18202a;
  font-weight: 700;
}

.tab.active::after {
  position: absolute;
  right: 22%;
  bottom: 0;
  left: 22%;
  height: 5rpx;
  background: #165dff;
  content: '';
}

.tab-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 7rpx;
  border-radius: 17rpx;
  background: #edf0f4;
  color: #77808c;
  font-size: 20rpx;
  box-sizing: border-box;
}

.tab.active .tab-count {
  background: #edf3ff;
  color: #165dff;
}

.batch-progress {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #d7e2ff;
  background: #edf3ff;
  color: #27466f;
  font-size: 24rpx;
  box-sizing: border-box;
}

.batch-stop {
  padding: 18rpx 0 18rpx 24rpx;
  color: #f04458;
  font-weight: 650;
}

.library-tools {
  padding: 22rpx 0 16rpx;
  background: #ffffff;
}

.mine-search {
  display: flex;
  align-items: center;
  height: 72rpx;
  margin: 0 30rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dfe4ea;
  border-radius: 7rpx;
  background: #f7f8fa;
  box-sizing: border-box;
}

.search-symbol {
  width: 38rpx;
  color: #59636f;
  font-size: 34rpx;
}

.mine-search-input {
  flex: 1;
  height: 100%;
  font-size: 25rpx;
}

.search-clear {
  padding: 8rpx;
  color: #77808c;
  font-size: 34rpx;
}

.tag-filter-scroll {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.tag-filter-row {
  display: inline-flex;
  gap: 10rpx;
  padding: 0 30rpx;
}

.filter-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border: 1rpx solid #dfe4ea;
  border-radius: 6rpx;
  background: #ffffff;
  color: #59636f;
  font-size: 23rpx;
  box-sizing: border-box;
}

.filter-tag.active {
  border-color: #18202a;
  background: #18202a;
  color: #ffffff;
}

.filter-count {
  color: #929ba6;
  font-size: 20rpx;
}

.filter-tag.active .filter-count {
  color: #cfd6df;
}

.mine-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  padding: 22rpx 30rpx 30rpx;
}

.mine-item {
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid #e6e9ee;
  border-radius: 8rpx;
  background: #ffffff;
}

.thumb {
  display: block;
  width: 100%;
  aspect-ratio: 1 / 1;
  background: #edf0f4;
}

.item-main {
  min-width: 0;
  padding: 16rpx 16rpx 13rpx;
}

.item-prompt,
.item-tags,
.item-status {
  display: block;
}

.item-prompt {
  overflow: hidden;
  font-size: 25rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-tags {
  overflow: hidden;
  margin-top: 9rpx;
  color: #77808c;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-top: 14rpx;
}

.item-status,
.item-date {
  color: #77808c;
  font-size: 20rpx;
}

.item-date {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-approved { color: #168a55; }
.status-rejected { color: #f04458; }
.status-pending,
.status-auto_reviewing,
.status-manual_review { color: #9b6508; }

.actions {
  display: flex;
  align-items: center;
  justify-content: space-around;
  min-height: 62rpx;
  padding: 0 8rpx;
  border-top: 1rpx solid #eef0f3;
}

.action {
  padding: 16rpx 8rpx;
  color: #59636f;
  font-size: 21rpx;
}

.action.primary { color: #165dff; }
.action.danger { color: #f04458; }

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: auto;
  height: 72rpx;
  margin: 0 30rpx 60rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dfe4ea;
  border-radius: 7rpx;
  background: #ffffff;
  color: #18202a;
  font-size: 24rpx;
  line-height: 1;
  box-sizing: border-box;
}

.load-more.loading {
  color: #77808c;
}

.load-more-spinner {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #dfe4ea;
  border-top-color: #59636f;
  border-radius: 50%;
  animation: load-more-spin 0.75s linear infinite;
  box-sizing: border-box;
}

@keyframes load-more-spin {
  to { transform: rotate(360deg); }
}

.mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(24, 32, 42, 0.52);
}

.sheet {
  width: 100%;
  max-height: 92vh;
  overflow-y: auto;
  padding: 30rpx 30rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 8rpx 8rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.sheet-head,
.field-head,
.tag-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet-title {
  font-size: 35rpx;
  font-weight: 750;
}

.sheet-close {
  padding: 8rpx 0 8rpx 24rpx;
  color: #77808c;
  font-size: 42rpx;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 300rpx;
  margin: 26rpx 0;
  border: 2rpx dashed #cfd6df;
  border-radius: 8rpx;
  background: #f7f8fa;
}

.picker-image {
  width: 100%;
  height: 100%;
}

.picker-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #59636f;
}

.picker-plus {
  margin-bottom: 8rpx;
  color: #165dff;
  font-size: 55rpx;
}

.picker-hint,
.field-hint {
  margin-top: 8rpx;
  color: #929ba6;
  font-size: 21rpx;
}

.field-label {
  display: block;
  margin: 20rpx 0 12rpx;
  font-weight: 650;
}

.field {
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dfe4ea;
  border-radius: 7rpx;
  background: #f7f8fa;
  font-size: 26rpx;
  box-sizing: border-box;
}

.field-head .field-hint { margin-top: 20rpx; }
.tag-field { flex: 1; }

.tag-add {
  margin-left: 18rpx;
  padding: 20rpx 8rpx;
  color: #165dff;
  font-weight: 650;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  min-height: 48rpx;
  margin-top: 16rpx;
}

.tag {
  padding: 10rpx 14rpx;
  border-radius: 6rpx;
  background: #edf3ff;
  color: #165dff;
  font-size: 23rpx;
}

.tag-remove { margin-left: 10rpx; }
.submit { margin-top: 28rpx; }
